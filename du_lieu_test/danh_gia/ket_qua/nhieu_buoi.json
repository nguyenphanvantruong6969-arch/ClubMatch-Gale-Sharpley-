 "ghi_chu": "Mỗi buổi: chỉ số A–C trên riêng buổi đó (mẫu số = mọi học sinh). theo_hoc_sinh: xem định nghĩa `tong_hop_theo_hoc_sinh`.",
 "dinh_nghia": {
  "luu_y": "TOÀN BỘ số đo trên DỮ LIỆU MÔ PHỎNG, không phải khảo sát học sinh thật.",
  "chi_so": {
   "pct_nv1_tat_ca": {
    "ten": "Tỉ lệ được nguyện vọng 1",
    "cong_thuc": "#(em được xếp ở nguyện vọng 1) / #học sinh",
    "mau_so": "mọi học sinh (kể cả danh sách rỗng, chưa được xếp)",
    "nhom": "A"
   },
   "pct_nv1_da_xep": {
    "ten": "Tỉ lệ nguyện vọng 1 trên em được xếp",
    "cong_thuc": "#(nguyện vọng 1) / #(em được xếp)",
    "mau_so": "em được xếp",
    "nhom": "A"
   },
   "duong_cong_don": {
    "ten": "Đường cong tích luỹ",
    "cong_thuc": "phần tử k = #(em được xếp ở nguyện vọng ≤ k) / #học sinh, k = 1..K",
    "mau_so": "mọi học sinh; K = độ dài danh sách dài nhất",
    "nhom": "A"
   },
   "hang_tb": {
    "ten": "Hạng nguyện vọng trung bình",
    "cong_thuc": "trung bình hạng (1 = nguyện vọng đầu) của em được xếp",
    "mau_so": "em được xếp",
    "nhom": "A"
   },
   "ngoai_danh_sach": {
    "ten": "Xếp ngoài danh sách",
    "cong_thuc": "#(em được xếp vào CLB không có trong danh sách của em); phải = 0",
    "mau_so": "—",
    "nhom": "A"
   },
   "cap_chan": {
    "ten": "Cặp phá vỡ (blocking pair)",
    "cong_thuc": "số cặp (em, CLB) em thích hơn và CLB nhận em theo hàm lựa chọn thật; RB-DA phải = 0",
    "mau_so": "—",
    "nhom": "A"
   },
   "pct_chua_xep": {
    "ten": "Tỉ lệ chưa được xếp",
    "cong_thuc": "#(em chưa được xếp) / #học sinh",
    "mau_so": "mọi học sinh",
    "nhom": "B"
   },
   "can_tren_ghep_cuc_dai": {
    "ten": "Cận trên: ghép cực đại",
    "cong_thuc": "kích thước ghép cực đại đồ thị (học sinh × CLB đã liệt kê, sức chứa CLB), BỎ QUA ưu tiên và ổn định",
    "mau_so": "—",
    "nhom": "B"
   },
   "khong_the_tranh": {
    "ten": "Không thể tránh (do dữ liệu)",
    "cong_thuc": "#học sinh − cận trên",
    "mau_so": "—",
    "nhom": "B"
   },
   "gia_uu_tien_on_dinh": {
    "ten": "Cái giá của ưu tiên + ổn định",
    "cong_thuc": "cận trên − #(em được xếp)",
    "mau_so": "—",
    "nhom": "B"
   },
   "nguyen_nhan": {
    "ten": "Nguyên nhân chưa xếp (loại trừ nhau, theo thứ tự)",
